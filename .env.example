# URL database libSQL/SQLite. Default: file SQLite lokal.
# Untuk Turso: libsql://<nama-db>-<org>.turso.io
DATABASE_URL=file:./data/suryahitung.db
# Token Turso (kosongkan untuk SQLite lokal)
DATABASE_AUTH_TOKEN=

# URL publik situs (untuk metadata, sitemap, tautan berbagi)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ambil data radiasi NASA POWER berdasarkan koordinat (true/false)
NASA_POWER_ENABLED=true
